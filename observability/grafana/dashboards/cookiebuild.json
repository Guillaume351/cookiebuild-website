      "id": 15,
      "options": {"legend": {"calcs": ["sum"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "sum by (result, edition) (increase(cookiebuild_client_version_connections_total[$__rate_interval]))", "legendFormat": "{{result}} · {{edition}}", "refId": "A"}],
      "title": "Client connections · accepted and rejected",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Accepted connections divided by accepted plus version-rejected connections over the selected version window.",
      "fieldConfig": {"defaults": {"decimals": 1, "min": 0, "max": 100, "unit": "percent"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24},
      "id": 16,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "targets": [{"expr": "100 * sum(increase(cookiebuild_client_version_connections_total{result=\"accepted\"}[${version_window}])) / clamp_min(sum(increase(cookiebuild_client_version_connections_total[${version_window}])), 1)", "refId": "A"}],
      "title": "Client-version acceptance rate · $version_window",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Top accepted client versions. Bedrock uses Floodgate's exact client version; Java uses the actual protocol label because no semantic Java version is exposed reliably at admission.",
