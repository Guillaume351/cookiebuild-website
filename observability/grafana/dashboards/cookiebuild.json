      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 32},
      "id": 17,
      "options": {"displayMode": "gradient", "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "orientation": "horizontal", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [{"expr": "topk(10, sum by (edition, client_version, protocol) (increase(cookiebuild_client_version_connections_total{result=\"accepted\"}[${version_window}])))", "instant": true, "legendFormat": "{{edition}} · {{client_version}} · protocol {{protocol}}", "refId": "A"}],
      "title": "Top accepted client versions · $version_window",
      "type": "bargauge"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Version refusals by too-old, too-new or unsupported direction. Unknown is retained when upstream does not expose the rejected client's exact version.",
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 32},
      "id": 18,
      "options": {"displayMode": "gradient", "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "orientation": "horizontal", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [{"expr": "sum by (edition, direction, client_version, protocol) (increase(cookiebuild_client_version_connections_total{result=\"rejected\"}[${version_window}]))", "instant": true, "legendFormat": "{{edition}} · {{direction}} · {{client_version}} · protocol {{protocol}}", "refId": "A"}],
      "title": "Rejected client versions · $version_window",
      "type": "bargauge"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "The least-used accepted versions with non-zero traffic, so minority clients remain visible instead of disappearing behind top versions.",
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 32},
      "id": 19,
      "options": {"displayMode": "gradient", "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "orientation": "horizontal", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [{"expr": "bottomk(10, sum by (edition, client_version, protocol) (increase(cookiebuild_client_version_connections_total{result=\"accepted\"}[${version_window}])) > 0)", "instant": true, "legendFormat": "{{edition}} · {{client_version}} · protocol {{protocol}}", "refId": "A"}],
      "title": "Minority accepted versions · $version_window",
      "type": "bargauge"
    }
