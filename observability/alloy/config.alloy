logging {
  level = "info"
}

local.file_match "minecraft" {
  path_targets = [{
    "__path__" = "/minecraft-logs/latest.log",
    "job" = "minecraft",
    "service_name" = "cookiebuild",
  }]
  sync_period = "10s"
}

loki.source.file "minecraft" {
  targets = local.file_match.minecraft.targets
  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
