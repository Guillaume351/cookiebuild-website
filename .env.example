NUXT_DATABASE_URL=postgresql://user:password@localhost:5432/cookiebuild

# Firebase Admin uses Application Default Credentials. Mount the service-account
# JSON as a secret file, or set its base64 form as a secret environment value.
# Never commit either credential.
NUXT_FIREBASE_PROJECT_ID=your-firebase-project-id
# Firebase Web API key used only by the server-side email/password exchange.
# It is not an Admin SDK credential, but keep environment configuration scoped.
NUXT_PUBLIC_FIREBASE_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/cookiebuild-firebase-admin.json
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=

# Enable only after the mobile migration and Firebase service-account secret are installed.
MOBILE_NOTIFICATION_WORKER_ENABLED=false
MOBILE_RETENTION_WORKER_ENABLED=true
MOBILE_FRIENDS_ENABLED=false
COOKIEBUILD_BEDWARS_ENABLED=false
MOBILE_PARTIES_ENABLED=false
# Enable only after the matching mobile/gameplay releases and runtime schema checks pass.
MOBILE_KIT_SHOP_ENABLED=false
MOBILE_PLAYER_DASHBOARD_ENABLED=false
# Enable reads only after add-skyblock-v1.sql, the gameplay plugin, website, and
# mobile client all expose the same v1 contract. Market writes are a separate kill switch.
MOBILE_SKYBLOCK_ENABLED=false
MOBILE_SKYBLOCK_MANAGEMENT_WRITES_ENABLED=false
MOBILE_SKYBLOCK_MARKET_WRITES_ENABLED=false
MOBILE_NOTIFICATION_WORKER_INTERVAL_MS=15000
MOBILE_NOTIFICATION_WORKER_BATCH_SIZE=10
MOBILE_NOTIFICATION_WORKER_CONCURRENCY=2
MOBILE_NOTIFICATION_MAX_ATTEMPTS=6
MOBILE_NOTIFICATION_STALE_LOCK_SECONDS=300
MOBILE_NOTIFICATION_SEND_TIMEOUT_MS=30000

# Must exactly match CookieDough. Generate at least 32 random bytes and store it
# only in Dokploy's secret environment configuration.
MOBILE_LINK_PEPPER=

# Admin control center. All URLs stay on the private application/observability network.
NUXT_ADMIN_RABBITMQ_URL=amqp://user:password@rabbitmq:5672/cookiebuild
NUXT_ADMIN_RABBITMQ_EXCHANGE=cookiebuild.admin
NUXT_ADMIN_RABBITMQ_EVENT_QUEUE=cookiebuild.admin.website.events
NUXT_ADMIN_DEFAULT_SERVER_ID=minecraft-1
NUXT_PROMETHEUS_URL=http://prometheus:9090
NUXT_LOKI_URL=http://loki:3100
NUXT_OPERATOR_URL=http://cookiebuild-operator:9410
NUXT_OPERATOR_HMAC_SECRET=
NUXT_UPDATE_MONITOR_URL=http://cookiebuild-update-monitor:9420
NUXT_UPDATE_MONITOR_HMAC_SECRET=
MOBILE_SKYBLOCK_MAINTENANCE_ENABLED=false
COOKIEBUILD_METRICS_TOKEN=

# Web-only commerce: leave unset until the matching account, catalog and webhook
# are verified. Test keys and live keys must never share an environment/database.
COMMERCE_STRIPE_MODE=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
COMMERCE_PUBLIC_BASE_URL=
COMMERCE_ALLOW_TEST_MODE_IN_PRODUCTION=false
# Explicitly choose true or false for live; tax codes required only when true.
COMMERCE_STRIPE_AUTOMATIC_TAX=
COMMERCE_STRIPE_TAX_CODE_DIGITAL=
COMMERCE_STRIPE_TAX_CODE_SUPPORT=
# Use actual seller information; do not copy fictitious values into production.
COMMERCE_LEGAL_NAME=
COMMERCE_LEGAL_ADDRESS=
COMMERCE_SUPPORT_EMAIL=
# test (non-live only), individual, company, or association.
COMMERCE_BUSINESS_STATUS=
COMMERCE_BUSINESS_ID=
# not_applicable or registered; VAT ID required when registered.
COMMERCE_VAT_STATUS=
COMMERCE_VAT_ID=
COMMERCE_MEDIATOR_NAME=
COMMERCE_MEDIATOR_URL=
# Bootstrap only: new file in a private directory outside this repository.
# Never add this temporary secret destination to the application runtime.
COMMERCE_WEBHOOK_SECRET_FILE=
COMMERCE_WEBHOOK_ROTATION_ID=
