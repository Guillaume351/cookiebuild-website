NUXT_DATABASE_URL=postgresql://user:password@localhost:5432/cookiebuild

# Firebase Admin uses Application Default Credentials. Mount the service-account
# JSON as a secret file, or set its base64 form as a secret environment value.
# Never commit either credential.
NUXT_FIREBASE_PROJECT_ID=your-firebase-project-id
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/cookiebuild-firebase-admin.json
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=

# Enable only after the mobile migration and Firebase service-account secret are installed.
MOBILE_NOTIFICATION_WORKER_ENABLED=false
MOBILE_NOTIFICATION_WORKER_INTERVAL_MS=15000
MOBILE_NOTIFICATION_WORKER_BATCH_SIZE=10
MOBILE_NOTIFICATION_WORKER_CONCURRENCY=2
MOBILE_NOTIFICATION_MAX_ATTEMPTS=6
MOBILE_NOTIFICATION_STALE_LOCK_SECONDS=300
MOBILE_NOTIFICATION_SEND_TIMEOUT_MS=30000

# Must exactly match CookieDough. Generate at least 32 random bytes and store it
# only in Dokploy's secret environment configuration.
MOBILE_LINK_PEPPER=
